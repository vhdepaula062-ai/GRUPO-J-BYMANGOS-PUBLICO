# ==============================================================================
# ECOSSISTEMA DIGITAL GRUPO J — TEMPLATE DE VARIÁVEIS DE AMBIENTE
# IMPORTANTE: Nunca insira segredos reais ou credenciais de produção neste arquivo.
# Copie este arquivo para .env.local em desenvolvimento.
# ==============================================================================

# AMBIENTE
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug

# SERVIÇO DE BANCO DE DADOS E AUTH (SUPABASE)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key-for-local-dev
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-service-role-key-for-local-dev

# URLS BASE DOS SERVIÇOS
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_WORKSHOP_URL=http://localhost:3001

# MOBILE (EXPO)
EXPO_PUBLIC_API_URL=http://localhost:3002
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key-for-local-dev

# GATEWAY DE PAGAMENTOS (MERCADO PAGO / ABSTRAÇÃO)
# Opções válidas: fake (apenas em desenvolvimento e testes) | mercadopago (homologação/produção)
PAYMENT_GATEWAY_PROVIDER=fake
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADO_PAGO_WEBHOOK_SECRET=dummy-webhook-secret-32-chars-long

# SEGURANÇA E CRIPTOGRAFIA DE CPF (LGPD)
# Chave AES-256 de 32 bytes (64 caracteres hexadecimais) para criptografar CPF no banco
CPF_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Pepper secreto para HMAC-SHA256 do Blind Index de CPF (64 caracteres hexadecimais)
CPF_BLIND_INDEX_PEPPER=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# SESSÃO E SEGREDOS DE COOKIE
SESSION_SECRET=minimo-32-caracteres-para-assinatura-de-sessao-segura-grupo-j
