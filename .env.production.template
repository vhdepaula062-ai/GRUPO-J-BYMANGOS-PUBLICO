# ==============================================================================
# ECOSSISTEMA DIGITAL GRUPO J — VARIÁVEIS DE AMBIENTE DE PRODUÇÃO
# ==============================================================================
# 
# INSTRUÇÕES:
# 1. Crie um projeto no Supabase: https://supabase.com/dashboard/new
# 2. Em "Project Settings" → "API", copie os valores abaixo
# 3. Configure na Vercel em: Project Settings → Environment Variables
# 4. Ou crie um arquivo .env.local (NUNCA faça commit deste arquivo!)
#
# Para gerar as chaves de segurança, use o comando no terminal:
#   node -e "require('crypto').randomBytes(32).toString('hex')"
# ==============================================================================

# --------------------------------------------------------------------------
# AMBIENTE
# --------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

# --------------------------------------------------------------------------
# SUPABASE — Banco de Dados e Autenticação
# --------------------------------------------------------------------------
# Encontre em: Supabase Dashboard → Project Settings → API

# URL do projeto Supabase (exemplo: https://abcdefghij.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=COLE_SUA_SUPABASE_URL_AQUI

# Chave pública "anon" (pode ser exposta no cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLE_SUA_ANON_KEY_AQUI

# Chave "service_role" — SEGREDO! Use apenas no servidor, NUNCA no cliente
SUPABASE_SERVICE_ROLE_KEY=COLE_SUA_SERVICE_ROLE_KEY_AQUI

# Para o app mobile Expo
EXPO_PUBLIC_SUPABASE_URL=COLE_SUA_SUPABASE_URL_AQUI
EXPO_PUBLIC_SUPABASE_ANON_KEY=COLE_SUA_ANON_KEY_AQUI

# --------------------------------------------------------------------------
# URLs DOS SERVIÇOS (ajuste para seus domínios reais)
# --------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_URL=https://grupo-j-admin.vercel.app
NEXT_PUBLIC_WORKSHOP_URL=https://grupo-j-oficinas.vercel.app
NEXT_PUBLIC_API_URL=https://grupo-j-api.vercel.app

# Para mobile
EXPO_PUBLIC_API_URL=https://grupo-j-api.vercel.app

# --------------------------------------------------------------------------
# GATEWAY DE PAGAMENTOS — PagSeguro / PagBank
# --------------------------------------------------------------------------
# Selecione o provedor contratado e configure credenciais válidas antes do deploy.

# Opções válidas: pagseguro | mercadopago
PAYMENT_GATEWAY_PROVIDER=disabled

# Após criar conta em https://pagseguro.uol.com.br/business/
# Acesse: Minha Conta → Preferências → Integrações → Tokens e Chaves
PAGSEGURO_EMAIL=SEU_EMAIL_PAGSEGURO@dominio.com
PAGSEGURO_TOKEN=SEU_TOKEN_PAGSEGURO_AQUI
PAGSEGURO_APP_ID=SEU_APP_ID_PAGSEGURO
PAGSEGURO_APP_KEY=SUA_APP_KEY_PAGSEGURO

# Modo: sandbox (testes) | production (real)
PAGSEGURO_MODE=sandbox

# Segredo para validar webhooks do PagSeguro
PAGSEGURO_WEBHOOK_SECRET=GERE_UM_SECRET_SEGURO_AQUI

# --------------------------------------------------------------------------
# SEGURANÇA E CRIPTOGRAFIA LGPD (AES-256-GCM + HMAC-SHA256)
# --------------------------------------------------------------------------
# IMPORTANTE: Gere valores únicos e aleatórios. Use:
#   node -e "require('crypto').randomBytes(32).toString('hex')"

# Chave AES-256 para criptografar CPF no banco (64 caracteres hexadecimais)
CPF_ENCRYPTION_KEY=GERE_64_CARACTERES_HEX_AQUI_NUNCA_USE_ESTE_PLACEHOLDER

# Pepper para HMAC-SHA256 do Blind Index de CPF (64 caracteres hexadecimais)
CPF_BLIND_INDEX_PEPPER=GERE_OUTROS_64_CARACTERES_HEX_AQUI_DIFERENTE_DO_ANTERIOR

# --------------------------------------------------------------------------
# SESSÃO
# --------------------------------------------------------------------------
# Mínimo 32 caracteres aleatórios. Gere com:
#   node -e "require('crypto').randomBytes(48).toString('base64')"
SESSION_SECRET=GERE_UM_SECRET_DE_SESSAO_FORTE_E_ALEATORIO_AQUI

# --------------------------------------------------------------------------
# CONFIGURAÇÕES OPCIONAIS FUTURAS
# --------------------------------------------------------------------------
# Notificações WhatsApp via Z-API (futura integração)
# ZAPI_INSTANCE_ID=
# ZAPI_TOKEN=

# AWS S3 / Cloudflare R2 para armazenamento de fotos dos check-ins
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=grupo-j-evidencias
# STORAGE_ENDPOINT=
