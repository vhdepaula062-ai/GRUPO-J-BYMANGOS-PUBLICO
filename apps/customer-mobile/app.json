{
  "expo": {
    "name": "Grupo J Staging",
    "slug": "grupo-j-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "grupoj",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#00091D",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.grupoj.autocenter.staging",
      "infoPlist": {
        "NSCameraUsageDescription": "O Grupo J necessita de acesso à câmera para fotografar o hodômetro e placa do veículo no check-in.",
        "NSLocationWhenInUseUsageDescription": "Sua localização é utilizada exclusivamente para exibir os centros automotivos credenciados mais próximos de você."
      }
    },
    "android": {
      "package": "br.com.grupoj.autocenter.staging",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00091D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "environment": "staging",
      "apiUrl": "https://grupo-j-api.vercel.app",
      "paymentMode": "sandbox",
      "planMonthlyPrice": 50.00
    }
  }
}
