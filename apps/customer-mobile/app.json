{
  "expo": {
    "name": "Grupo J",
    "slug": "grupo-j-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "grupoj",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#00091D",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.grupoj.customer",
      "infoPlist": {
        "NSCameraUsageDescription": "O Grupo J necessita de acesso à câmera para fotografar o hodômetro e placa do veículo no check-in.",
        "NSLocationWhenInUseUsageDescription": "Sua localização é utilizada exclusivamente para exibir os centros automotivos credenciados mais próximos de você."
      }
    },
    "android": {
      "package": "com.grupoj.customer",
      "adaptiveIcon": {
        "backgroundColor": "#00091D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
