{
  "expo": {
    "name": "Grupo J",
    "slug": "grupo-j-customer",
    "version": "0.2.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "grupoj",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#00091D",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.grupoj.autocenter.staging"
    },
    "android": {
      "package": "br.com.grupoj.autocenter.staging",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#034EFE"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "environment": "staging",
      "apiUrl": "https://grupo-j-api.vercel.app",
      "paymentMode": "unconfigured"
    }
  }
}
