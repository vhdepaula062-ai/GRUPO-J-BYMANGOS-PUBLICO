{
  "extends": "@grupo-j/typescript-config/nextjs.json",
  "compilerOptions": {
    "rootDir": "./",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
